{
  "manifest_version": 3,
  "name": "Simple Ads Blocker",
  "version": "1.15",
  "description": "Simple extension to quickly remove ads on specific websites, and reduce some from others.",
  "icons": {
    "128": "cow.png"
  },
  "author": "Tien Do",
  "homepage_url": "https://github.com/tiendq",
  "permissions": [
    "declarativeNetRequest"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
