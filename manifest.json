{
  "manifest_version": 3,
  "name": "Simple Ad Blocker",
  "version": "1.13",
  "description": "Simple extension to quickly removes ads on specific websites, and reduces some from others.",
  "author": "Tien Do",
  "homepage_url": "https://github.com/tiendq",
  "permissions": [
    "declarativeNetRequest"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "config.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
